# Frontend Environment Variables
# API Base URL - change this if your backend runs on a different port or host
# This is used by the frontend client to connect to the backend server
# For local development:
VITE_API_BASE=http://localhost:5000
# For production (update with your Render backend URL):
# VITE_API_BASE=https://your-app-name.onrender.com

# Backend Environment Variables
# Database connection URL
# For local development (use your local PostgreSQL or a free tier DB):
DATABASE_URL=postgresql://neondb_owner:password@db.example.com:5432/mydatabase
# For production, set this in Render dashboard

# Server port (default: 5000)
PORT=5000

# JWT Secret for authentication (generate a secure random string for production)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node environment
NODE_ENV=development
# For production, set to: production
